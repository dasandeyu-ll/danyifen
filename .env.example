# 复制为 .env 后按需修改
# 不填 DEEPSEEK_API_KEY 也能完整运行 —— 系统会自动降级到内置规则引擎

# 留空 = 规则引擎模式（零依赖、可离线跑通）
DEEPSEEK_API_KEY=

# auto：有 key 用大模型，没有就降级；rule：强制规则引擎；llm：强制大模型
ANALYZER_MODE=auto

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 置信度低于该值 → 自动转人工
CONFIDENCE_THRESHOLD=0.62
# 前两名意图分差占比低于该值 → 视为"意图打架"，也转人工
MARGIN_THRESHOLD=0.18

# 后端开发时用 Vite 代理连前端；改端口时同步改这里
VITE_API_TARGET=http://127.0.0.1:8000
